# App config
PORT=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Frontend
CORS_ORIGIN=http://localhost:8000

# Database config
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me_local
DB_NAME=healthy

# TypeORM options
TYPEORM_SYNC=false
TYPEORM_LOG=true
TYPEORM_RETRY_ATTEMPTS=1
TYPEORM_RETRY_DELAY=3000

# JWT config
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret
OTP_HMAC_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=1d
SESSION_TOKEN_EXPIRES_IN=365d
TOKEN_ISSUER=http://localhost:3000
TOKEN_AUDIENCE=http://localhost:3000

# Redis config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2
REDIS_TOKEN_DB=3

# Redis cluster
REDIS_CLUSTER_NODES=localhost:7100,localhost:7101,localhost:7102,localhost:7103,localhost:7104,localhost:7105
REDIS_CLUSTER_PASSWORD=replace_with_a_strong_password
RECENT_MESSAGE_CACHE_TTL_SECONDS=900

# RabbitMQ config
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672

RABBITMQ_PREFETCH_CHAT_1ON1=20
RABBITMQ_PREFETCH_CHAT_GROUP=20
RABBITMQ_PREFETCH_CHAT_NOTIFICATION=50

RABBITMQ_RETRY_CHAT_1ON1=3
RABBITMQ_RETRY_CHAT_GROUP=3
RABBITMQ_RETRY_CHAT_NOTIFICATION=5

# WebSocket Config
WS_PATH=/ws/mqttbypass
WS_NAMESPACE=/chatins
WS_CORS_ORIGIN=http://localhost:8000
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=10000
WS_CONNECTION_TTL=21600
WS_PRESENCE_TTL=21600
WS_SOCKET_META_TTL=21600
WS_NODES_TTL=21600
WS_NODE_HEARTBEAT_TTL=60
WS_CORS_ORIGINS=http://localhost:8000

# Web Push VAPID Configuration
VAPID_SUBJECT=mailto:example@yourdomain.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Node ID
NODE_ID=node1

# SMTP MAILER
GMAIL_USER=example@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_SENDER_NAME=Lusi
GMAIL_REPLY_TO=lusi@yourapp.com

# WORKER
WORKER_ID=1

# Cloudflare R2 (S3-compatible storage)
R2_ACCOUNT_ID=your_32_character_cloudflare_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_UPLOAD_URL_EXPIRATION_MINUTES=15
R2_PLAYBACK_URL_EXPIRATION_MINUTES=60
MESSAGE_UPLOAD_CLEANUP_INTERVAL_MS=1800000
MESSAGE_UPLOAD_CLEANUP_BATCH_SIZE=100
# Optional; only set this when public bucket access is enabled.
R2_PUBLIC_URL=https://your_public_bucket_id.r2.dev
